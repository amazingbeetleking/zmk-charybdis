#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150
#include <dt-bindings/zmk/pointing.h>

#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#include "layers.h"

#include "behaviors.dtsi"
#include "combos.dtsi"
#include "macros.dtsi"

&lt {
    tapping-term-ms = <160>;
};

/ {
    macros {

        ctrl_cmd_hold: ctrl_cmd_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LGUI &mkp LCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp LCLK &kp LCTRL &kp LGUI>
                ;
        };

        alt_dot: alt_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N0 &kp KP_N4 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        alt_bslh: alt_bslh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N0 &kp KP_N9 &kp KP_N2>
                , <&macro_release &kp LALT>
                ;
        };

        alt_colon: alt_colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N0 &kp KP_N5 &kp KP_N8>
                , <&macro_release &kp LALT>
                ;
        };

        alt_semi: alt_semi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N0 &kp KP_N5 &kp KP_N9>
                , <&macro_release &kp LALT>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            display-name = "Base";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &hm_l LGUI A  &hm_l LALT S  &hm_l LCTRL D &hm_l LSHFT F &kp G             &kp H         &hm_r RSHFT J &hm_r RCTRL K &hm_r RALT L  &hm_r RGUI SEMI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &lt POI Z     &kp X         &kp C         &kp V         &kp B             &kp N         &kp M         &kp COMMA     &kp DOT       &lt POI FSLH
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                             &mo_tog SCR SCR  &lt NAVI SPACE &lt FUNC TAB     &lt SYMB ENTER &lt NUMB BSPC
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        number_layer {
            label = "NUMB";
            display-name = "Number";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp GRAVE     &kp N7        &kp N8        &kp N9        &kp RBKT          &trans        &alt_semi     &kp LBKT      &kp RBKT      &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LBKT      &kp N4        &kp N5        &kp N6        &kp EQUAL         &alt_colon    &kp RSHFT    &mt LCTRL LPAR &mt LALT RPAR &kp RGUI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp APOS      &kp N1        &kp N2        &kp N3        &kp KP_DIVIDE     &trans        &trans        &kp LBRC      &kp RBRC      &trans
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                 &alt_dot      &kp N0        &kp MINUS         &trans        &trans
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        symbol_layer {
            label = "SYMB";
            display-name = "Symbol";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp TILDE     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RBRC          &trans        &trans        &bt BT_CLR_ALL &trans       &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LBRC      &kp DLLR      &kp PRCNT     &kp CARET     &kp PLUS          &trans        &kp RSHFT     &kp RCTRL     &kp RALT      &kp RGUI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp DQT       &kp EXCL      &kp AT        &kp HASH      &kp BSLH          &trans        &trans        &trans        &trans        &trans
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                 &kp LPAR      &kp RPAR      &kp UNDER         &trans        &trans
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        navigation_layer {
            label = "NAVI";
            display-name = "Navigation";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans            &none         &none         &none         &none         &none
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHFT     &trans            &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp ESC
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans            &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp K_APP
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                 &trans        &trans        &trans            &kp ENTER     &kp DEL
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        function_layer {
            label = "FUNC";
            display-name = "Function";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &none             &kp PSCRN     &kp F7        &kp F8        &kp F9        &kp F12
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHFT     &trans            &kp INS       &kp F4        &kp F5        &kp F6        &kp F11
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans            &kp KP_NUM    &kp F1        &kp F2        &kp F3        &kp F10
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                 &trans        &trans        &trans            &kp LC(KP_MINUS) &kp PIPE
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        pointer_layer {
            label = "POINTER";
            display-name = "Pointer";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHFT     &trans            &kp C_VOL_UP  &kp RSHFT     &kp RCTRL     &kp RALT      &kp RGUI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &kp LC(X)     &kp LC(C)     &kp LC(V)     &trans            &kp C_VOL_DN  &kp C_PP      &trans        &trans        &trans
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                 &mo SNI       &mkp LCLK     &mkp RCLK         &mkp MCLK     &mkp LCLK
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        scroll_layer {
            label = "SCROLL";
            display-name = "Scroll";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &kp LCTRL     &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                 &trans        &trans        &trans            &trans        &trans
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };

        sniper_layer {
            label = "SNIPER";
            display-name = "Sniper";
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
//                              ╭─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                                 &trans        &trans        &trans            &trans        &trans
//                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────╯
            >;
        };
    };
};
